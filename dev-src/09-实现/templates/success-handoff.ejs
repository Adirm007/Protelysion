let bsMatches = bsNativeMessage?.is_user === true && /^\s*离开普罗泰利西翁\s*$/.test(String(bsExitText ?? ''));
let bsBook = typeof getvar === 'function' ? getvar('booksea', { scope: 'local', defaults: {} }) : {};
